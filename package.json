{
  "name": "screendesc",
  "private": true,
  "version": "1.0.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/copy-ort-assets.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "fetch-ocr-model": "node scripts/fetch-ocr-model.mjs",
    "build": "vue-tsc -b && vite build",
    "build:desktop": "vue-tsc -b && vite build --mode desktop",
    "build:pages": "npm run fetch-model && npm run fetch-ocr-model && npm run build",
    "preview": "vite preview",
    "desktop:run": "npm run build:desktop && deno run -A desktop/pack.ts",
    "desktop:package": "npm run build:desktop && deno run -A desktop/pack.ts dist-desktop/ScreenDesc",
    "desktop:release:macos": "deno run -A installer/macos/release.ts"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "^0.4.2",
    "onnxruntime-web": "^1.27.0",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "sass": "^1.101.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  }
}
